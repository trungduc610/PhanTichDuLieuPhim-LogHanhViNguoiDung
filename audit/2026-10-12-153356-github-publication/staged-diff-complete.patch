+0031:        'raw_version_text_unchanged':previous['before']==previous['after'],
+0032:        'note':'Original FAIL retained. Only timestamp comments changed; all properties and actual data bytes/counts were compared. No second restart or reformat was needed.'}
+0033:     new_json(Path(evidence)/'persistence-reviewed.json',result)
