+0046:     acceptance=json.loads((evidence/'acceptance_status.json').read_text(encoding='utf-8'))
+0047:     if remote['status']!='PASS' or remote['source_manifest_sha256']!=sha256(evidence/'source_manifest.json') or any(v!='ĐẠT' for v in acceptance['stages'].values()):
+0048:         raise ValueError('Requires verified remote bytes and five completed stages')
+0049:     scopes=['scripts','src','tests','config','docs','data/raw','data/processed','data/generated',
+0050:             'data/runs/run-aa6b9eb58dca/output','evidence/run-aa6b9eb58dca',
+0051:             'evidence/recheck-20261011-221710',context['evidence'],context['audit']]
+0052:     selected={ROOT/n for n in ['README.md','Dockerfile','compose.yaml','compose.hdfs.yaml',
+0053:                   'requirements.txt','.gitignore','.gitattributes','.dockerignore',
+0054:                   'audit/2026-10-11-221710-week1-recheck/bao-cao-nghiem-thu-tuan-1-recheck.md']}
+0055:     for scope in scopes:selected.update(p for p in (ROOT/scope).rglob('*') if p.is_file())
+0056:     entries={}
+0057:     omitted=[]
