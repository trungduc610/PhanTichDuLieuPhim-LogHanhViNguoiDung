+0025:     new_json(ROOT/a.audit_dir/'run-context.json',context)
+0026:     ledger=Ledger(evidence,{'HDFS_RUN_ID':run_id})
+0027:     base=compose(project)
+0028:     state={'runtime':'CHƯA THỂ XÁC MINH','upload':'CHƯA THỂ XÁC MINH','content':'CHƯA THỂ XÁC MINH',
+0029:            'spark':'CHƯA THỂ XÁC MINH','e2e':'CHƯA THỂ XÁC MINH'}
+0030:     try:
+0031:         source_manifest(run_id,evidence)
+0032:         ledger.command(['docker','version'],'docker-version')
+0033:         ledger.command(['docker','compose','version'],'compose-version')
+0034:         ledger.command(['docker','context','show'],'context')
+0035:         ledger.command(['docker','image','inspect','apache/hadoop:3.3.6','apache/spark:3.5.1'],'images')
+0036:         for volume in ['namenode','datanode']:
+0037:             code,_,_=ledger.command(['docker','volume','inspect',project+'_'+volume],'new-volume-'+volume,False)
+0038:             if code==0:raise ValueError('Volume already exists; refusing reuse')
+0039:         ledger.command(base+['config'],'compose-resolved')
+0040:         ledger.command(base+['up','-d','namenode','datanode'],'start-only-hdfs')
+0041:         ready=False
+0042:         for attempt in range(24):
+0043:             code,text,_=ledger.command(base+['exec','-T','namenode','hdfs','dfsadmin','-report'],f'ready-{attempt:02d}',False)
+0044:             if code==0 and 'Live datanodes (1)' in text:
+0045:                 code,safe,_=ledger.command(base+['exec','-T','namenode','hdfs','dfsadmin','-safemode','get'],f'safe-{attempt:02d}',False)
+0046:                 if code==0 and 'Safe mode is OFF' in safe:
+0047:                     ready=True;break
+0048:             time.sleep(5)
+0049:         if not ready:raise RuntimeError('HDFS failed to reach one live DataNode outside safe mode')
+0050:         for service in ['namenode','datanode']:
+0051:             ledger.command(base+['exec','-T',service,'hadoop','version'],service+'-version')
+0052:             ledger.command(base+['exec','-T',service,'java','-version'],service+'-java')
+0053:             ledger.command(base+['exec','-T',service,'cat',f'/hdfs/{"name" if service=="namenode" else "data"}/current/VERSION'],service+'-storage-version')
+0054:         ledger.command(base+['ps','--all'],'ps')
+0055:         ledger.command(base+['logs','--timestamps','--no-color'],'logs-runtime')
+0056:         ledger.command(['docker','volume','inspect',project+'_namenode',project+'_datanode'],'volumes')
+0057:         ledger.command(base+['exec','-T','namenode','hdfs','getconf','-confKey','fs.defaultFS'],'default-fs')
+0058:         state['runtime']='ĐẠT'
+0059:     except Exception as exc:
+0060:         state['reason']=str(exc)
+0061:         try:ledger.command(base+['logs','--timestamps','--no-color'],'logs-failure',False)
+0062:         except Exception:pass
+0063:     state.update(finished_at_utc=utcnow(),run_id=run_id,project=project)
+0064:     new_json(evidence/'runtime_status.json',state)
+0065:     print(json.dumps({'context':context,'status':state},ensure_ascii=False,indent=2))
+0066:     return 0 if state['runtime']=='ĐẠT' else 1
+0067: 
+0068: if __name__=='__main__':
+0069:     p=argparse.ArgumentParser(description=__doc__)
+0070:     p.add_argument('--audit-dir',required=True)
+0071:     raise SystemExit(run(p.parse_args()))
