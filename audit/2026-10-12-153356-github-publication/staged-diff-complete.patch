+    9: def inspect_movies(path):
+   10:     path = Path(path)
+   11:     ids, issues, rows = set(), [], 0
+   12:     missing_year = no_genres = 0
+   13:     with path.open(encoding='utf-8', errors='strict', newline='') as f:
+   14:         reader = csv.DictReader(f, strict=True)
+   15:         if reader.fieldnames not in [['movieId', 'title', 'genres'], ['movieId', 'title', 'genres', 'releaseYear']]:
+   16:             raise ValueError('Unexpected movie CSV header')
+   17:         normalized = 'releaseYear' in reader.fieldnames
+   18:         for row in reader:
+   19:             rows += 1
+   20:             location = f'{path}:{reader.line_num}'
+   21:             errors = []
+   22:             if None in row or any(v is None for v in row.values()):
+   23:                 errors.append('Malformed CSV field count')
+   24:             else:
+   25:                 try:
+   26:                     mid = int(row['movieId'])
+   27:                     if not 1 <= mid <= 2**63-1:
+   28:                         raise ValueError('movieId outside positive signed long range')
+   29:                     if mid in ids:
+   30:                         errors.append('duplicate movieId')
+   31:                     ids.add(mid)
+   32:                 except ValueError as exc:
+   33:                     errors.append(str(exc))
+   34:                 for key in ['title', 'genres']:
+   35:                     if not row[key].strip():
+   36:                         errors.append('missing ' + key)
+   37:                     if '\ufffd' in row[key] or '\x00' in row[key]:
+   38:                         errors.append('invalid content ' + key)
+   39:                 no_genres += row['genres'] == '(no genres listed)'
+   40:                 if normalized:
+   41:                     year = row['releaseYear']
+   42:                     missing_year += not bool(year)
+   43:                     match = re.search(r'\((\d{4})\)\s*$', row['title'])
+   44:                     expected = int(match.group(1)) if match and 1870 <= int(match.group(1)) <= 2100 else None
+   45:                     try:
+   46:                         actual = int(year) if year else None
+   47:                         if actual != expected:
+   48:                             errors.append('releaseYear does not match documented title rule')
+   49:                     except ValueError:
+   50:                         errors.append('invalid releaseYear')
+   51:                     if row['title'] != unicodedata.normalize('NFC', row['title'].strip()):
+   52:                         errors.append('title not normalized')
+   53:             if errors:
+   54:                 issues.append({'location': location, 'movieId': row.get('movieId'), 'errors': errors})
+   55:     result = {'path': str(path), 'sha256': sha256(path), 'bytes': path.stat().st_size,
+   56:               'rows': rows, 'unique_movie_ids': len(ids), 'error_rows': len(issues),
+   57:               'issues_sample': issues[:20], 'releaseYear_null_allowed': missing_year,
+   58:               'no_genres_listed': no_genres, 'status': 'PASS' if rows and not issues else 'FAIL'}
+   59:     return ids, result
