+0050:         _,text,_=ledger.command(base+['exec','-T',service,'cat',f'/hdfs/{store}/current/VERSION'],'version-before-restart-'+service)
+0051:         before[service]=text
+0052:     ledger.command(base+['restart','namenode','datanode'],'restart-own-hdfs')
+0053:     ready=False
+0054:     for attempt in range(24):
+0055:         code,text,_=ledger.command(base+['exec','-T','namenode','hdfs','dfsadmin','-report'],f'restart-ready-{attempt:02d}',False)
