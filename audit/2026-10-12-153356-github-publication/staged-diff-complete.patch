+   20: movies = spark.read.option('header', True).option('escape', '"').schema(MOVIE_SCHEMA).csv('data/processed/movies.csv')
+   21: events = spark.read.schema(USER_LOG_SCHEMA).json('data/runs/run-aa6b9eb58dca/output/*.jsonl')
