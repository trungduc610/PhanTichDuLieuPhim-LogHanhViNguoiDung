+   10: 
+   11: 
+   12: def prepare(source, output, report):
+   13:     source, output = Path(source), Path(output)
+   14:     if Path(report).exists():
+   15:         raise FileExistsError('Use a new --report; prior evidence will not be overwritten')
+   16:     if output.exists():
+   17:         raise FileExistsError('Use a new --output; normalized data will not be overwritten')
+   18:     counts = Counter()
+   19:     rows, seen, issues = [], set(), []
+   20:     with source.open(encoding='utf-8', errors='strict', newline='') as f:
+   21:         reader = csv.DictReader(f, strict=True)
+   22:         if reader.fieldnames != ['movieId', 'title', 'genres']:
+   23:             raise ValueError('Unexpected CSV header')
+   24:         for line, row in enumerate(reader, 2):
+   25:             counts['input_rows'] += 1
+   26:             if None in row or any(v is None for v in row.values()):
+   27:                 raise ValueError(f'Malformed CSV row {line}')
+   28:             if any('\ufffd' in v or '\x00' in v for v in row.values()):
+   29:                 raise ValueError(f'Encoding replacement/NUL character on row {line}')
+   30:             try:
+   31:                 mid = int(row['movieId'])
+   32:                 assert mid > 0
+   33:             except (ValueError, AssertionError):
+   34:                 raise ValueError(f'Invalid movieId on row {line}')
+   35:             if mid in seen:
+   36:                 counts['duplicate_movie_ids'] += 1
+   37:                 issues.append({'line': line, 'movieId': mid, 'issue': 'duplicate_movieId'})
+   38:             seen.add(mid)
+   39:             title = unicodedata.normalize('NFC', row['title'].strip())
+   40:             genres = '|'.join(dict.fromkeys(g.strip() for g in row['genres'].split('|') if g.strip()))
+   41:             counts['missing_title'] += not bool(title)
+   42:             counts['missing_genres'] += not bool(genres)
+   43:             counts['no_genres_listed'] += genres == '(no genres listed)'
+   44:             match = re.search(r'\((\d{4})\)\s*$', title)
+   45:             year = int(match.group(1)) if match else None
+   46:             # Fixed, documented range makes cleaning reproducible across dates.
+   47:             if year is not None and not 1870 <= year <= 2100:
+   48:                 year = None
+   49:             if year is None:
+   50:                 counts['missing_or_unparsed_release_year'] += 1
+   51:                 issues.append({'line': line, 'movieId': mid, 'issue': 'releaseYear_unavailable', 'title': title})
+   52:             counts['normalized_rows_changed'] += title != row['title'] or genres != row['genres'] or str(mid) != row['movieId']
+   53:             rows.append({'movieId': mid, 'title': title, 'genres': genres, 'releaseYear': year if year is not None else ''})
+   54:     stats = {k: counts[k] for k in ['input_rows', 'duplicate_movie_ids', 'missing_title', 'missing_genres', 'no_genres_listed', 'missing_or_unparsed_release_year', 'normalized_rows_changed']}
+   55:     stats.update({'source': str(source), 'source_sha256': sha256(source), 'checked_at_utc': utcnow(),
+   56:                   'utf8_decode_errors': 0, 'csv_format_errors': 0, 'issues': issues,
+   57:                   'related_csv_rows': {}})
+   58:     for name in ['ratings', 'tags', 'links']:
+   59:         sibling = source.with_name(name + '.csv')
+   60:         if sibling.exists():
+   61:             with sibling.open(encoding='utf-8', newline='') as f:
+   62:                 stats['related_csv_rows'][name] = sum(1 for _ in csv.DictReader(f, strict=True))
+   63:     if not rows or counts['duplicate_movie_ids'] or counts['missing_title'] or counts['missing_genres']:
+   64:         stats['status'] = 'FAIL'
+   65:         write_json(report, stats)
+   66:         raise ValueError('Fatal data quality errors; inspect QA report')
+   67:     output.parent.mkdir(parents=True, exist_ok=True)
+   68:     with output.open('x', encoding='utf-8', newline='') as f:
+   69:         writer = csv.DictWriter(f, fieldnames=['movieId', 'title', 'genres', 'releaseYear'], lineterminator='\n')
+   70:         writer.writeheader()
+   71:         writer.writerows(rows)
+   72:     stats.update({'status': 'PASS', 'output_rows': len(rows), 'output_sha256': sha256(output)})
+   73:     write_json(report, stats)
+   74:     print(json.dumps(stats, ensure_ascii=False, indent=2))
+   75:     return stats
+   76: 
+   77: 
+   78: if __name__ == '__main__':
+   79:     p = argparse.ArgumentParser(description=__doc__)
+   80:     p.add_argument('--source', default='data/raw/ml-latest-small/movies.csv')
+   81:     p.add_argument('--output', default='data/processed/movies.csv')
+   82:     p.add_argument('--report', default='evidence/dataset_quality.json')
+   83:     a = p.parse_args()
+   84:     prepare(a.source, a.output, a.report)
