+### scripts/hdfs_service.sh
+0001: #!/usr/bin/env bash
+0002: set -euo pipefail
+0003: role="${1:?namenode or datanode required}"
+0004: : "${HDFS_RUN_ID:?Use a dedicated HDFS run ID}"
+0005: [[ "$HDFS_RUN_ID" =~ ^hdfs-[a-f0-9]{12}$ ]] || { echo 'Invalid cluster ID'; exit 1; }
+0006: case "$role" in
+0007:   namenode) store=/hdfs/name ;;
+0008:   datanode) store=/hdfs/data ;;
+0009:   *) echo 'Unknown role'; exit 1 ;;
+0010: esac
+0011: mkdir -p "$store"
+0012: if [[ -f "$store/current/VERSION" ]]; then
+0013:   actual=$(sed -n 's/^clusterID=//p' "$store/current/VERSION")
+0014:   [[ "$actual" == "$HDFS_RUN_ID" ]] || { echo 'Cluster ID mismatch: refusing existing volume'; exit 1; }
+0015:   echo "REUSE_VERIFIED_VOLUME role=$role cluster=$actual"
+0016: elif [[ -n "$(find "$store" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
+0017:   echo "Refusing non-empty unformatted $role volume"; exit 1
+0018: elif [[ "$role" == namenode ]]; then
+0019:   echo "FORMAT_NEW_EMPTY_VOLUME role=$role cluster=$HDFS_RUN_ID"
+0020:   hdfs namenode -format -clusterId "$HDFS_RUN_ID" -nonInteractive
+0021: else
+0022:   echo "NEW_EMPTY_VOLUME role=$role cluster=$HDFS_RUN_ID"
+0023: fi
+0024: exec hdfs "$role"
+
