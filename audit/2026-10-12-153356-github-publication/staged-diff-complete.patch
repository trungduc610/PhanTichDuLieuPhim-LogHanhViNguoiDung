+    return 0 if state['runtime']=='ĐẠT' else 1
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--audit-dir',required=True)
+    raise SystemExit(run(p.parse_args()))
