+0042:     context=json.loads(Path(args.context).read_text(encoding='utf-8'))
+0043:     evidence=ROOT/context['evidence']
+0044:     remote=json.loads((evidence/'final-hdfs-hashes.json').read_text(encoding='utf-8'))
