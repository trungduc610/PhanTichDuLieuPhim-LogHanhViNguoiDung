+0010: 
+0011: 
+0012: def verify(path):
+0013:     manifest=json.loads(Path(path).read_text(encoding='utf-8'))
+0014:     issues=[]
+0015:     for rel,expected in manifest['files'].items():
+0016:         file=(ROOT/rel).resolve()
+0017:         if not file.is_relative_to(ROOT) or not file.is_file():
+0018:             issues.append({'path':rel,'error':'missing or outside project'})
+0019:         elif file.stat().st_size!=expected['bytes'] or sha256(file)!=expected['sha256']:
+0020:             issues.append({'path':rel,'error':'bytes/SHA256 mismatch'})
+0021:     return {'status':'PASS' if not issues else 'FAIL','checked_at_utc':utcnow(),
+0022:             'manifest_sha256':sha256(path),'files_checked':len(manifest['files']),
+0023:             'total_bytes':sum(f['bytes'] for f in manifest['files'].values()),'issues':issues,
+0024:             'remote_note':'This verifies local files only. Re-run hdfs_hash_verify.py for current HDFS bytes; the immutable recorded remote receipt is included in the manifest.'}
+0025: 
+0026: 
